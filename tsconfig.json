{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "db/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist", "client", "records"]
}
