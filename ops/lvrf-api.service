[Unit]
Description=LVRF API
After=network.target postgresql.service
Requires=postgresql.service
[Service]
Type=simple
User=brad
# S2 (LVRF_PLAN §21, D2): the API, and only it, reaches the research process's socket. The user brad is not in this group.
SupplementaryGroups=lvrf_research
WorkingDirectory=/srv/lvrf
EnvironmentFile=/srv/lvrf/.env
ExecStart=/usr/bin/node /srv/lvrf/dist/server/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
